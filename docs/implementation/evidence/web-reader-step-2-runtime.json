{
  "model": "qwen3.8-flash",
  "service_host": "maas.qianwenaiapi.com",
  "embedding": "qwen3.7-text-embedding-flash",
  "reranker": "qwen3.7-text-rerank",
  "limits": {
    "model_calls": 6,
    "tool_calls": 10,
    "total_tokens": 64000,
    "timeout": 120
  },
  "web_reader": {
    "timeout": 20,
    "page_chars": 5000
  },
  "tool_contract_version": 2,
  "definitions": [
    {
      "type": "function",
      "function": {
        "name": "knowledge_base_search",
        "strict": true,
        "description": "检索用户已选择且有权访问的知识库，返回带分块位置的资料。范围由服务器固定。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "description": "知识库检索子问题",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Query",
              "type": "string"
            },
            "top_k": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "title": "Top K",
              "type": "integer"
            }
          },
          "required": [
            "query"
          ],
          "title": "KnowledgeSearchArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_search",
        "strict": true,
        "description": "用一个最多 120 字符的 query 搜索。完整 directory 供选择，摘要不是网页正文。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "description": "完整搜索短语，单行且非空白，最多 120 字符；仅必要公开信息，禁止私有资料原文",
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f]*\\S[^\\u0000-\\u001f]*$",
              "title": "Query",
              "type": "string"
            },
            "max_results": {
              "default": 5,
              "maximum": 5,
              "minimum": 1,
              "title": "Max Results",
              "type": "integer"
            }
          },
          "required": [
            "query"
          ],
          "title": "WebSearchArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_read",
        "strict": true,
        "description": "通过 directory 中的 source_id 读取正文；首次抓取后固定使用本次快照。start/max_chars 可定位其他片段，返回原文字符范围。不能填写网址。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "maxLength": 32,
              "pattern": "^web_[1-9][0-9]*$",
              "title": "Source Id",
              "type": "string"
            },
            "start": {
              "default": 0,
              "description": "正文字符起点；首次从 0 开始",
              "maximum": 2000000,
              "minimum": 0,
              "title": "Start",
              "type": "integer"
            },
            "max_chars": {
              "default": 5000,
              "maximum": 5000,
              "minimum": 100,
              "title": "Max Chars",
              "type": "integer"
            }
          },
          "required": [
            "source_id"
          ],
          "title": "WebReadArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "web_find",
        "strict": true,
        "description": "在已用 web_read 读取的本次快照中查找 pattern，返回首个命中附近原文及最多 10 个位置；不发网络请求。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "maxLength": 32,
              "pattern": "^web_[1-9][0-9]*$",
              "title": "Source Id",
              "type": "string"
            },
            "pattern": {
              "description": "已读取正文中的字面文本，不是正则",
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Pattern",
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "pattern"
          ],
          "title": "WebFindArguments",
          "type": "object"
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "finish_research",
        "strict": true,
        "description": "证据齐备或已确认资料不足时单独调用，提交实际已送模的 citation_ids 和 outcome。answered 必须有证据；使用网页摘要时还须有正文依据。该动作结束取证，随后独立生成答案，不再探索。",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "answered",
                "insufficient"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "citation_ids": {
              "items": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "maxItems": 30,
              "title": "Citation Ids",
              "type": "array"
            }
          },
          "required": [
            "outcome",
            "citation_ids"
          ],
          "title": "FinishArguments",
          "type": "object"
        }
      }
    }
  ],
  "source_sha256": {
