        "name": "web_read",
        "strict": true,
        "description": "\u8bfb\u53d6\u672c\u6b21\u5df2\u53d1\u73b0\u6216\u7528\u6237\u660e\u786e\u63d0\u4f9b\u7684\u516c\u5f00\u7f51\u9875\u6b63\u6587\uff1b\u4e0d\u80fd\u8bbf\u95ee\u5185\u7f51\u6216\u4efb\u610f\u65b0\u7f51\u5740\u3002",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "urls": {
              "description": "\u672c\u6b21\u641c\u7d22\u5df2\u8fd4\u56de\u6216\u7528\u6237\u660e\u786e\u63d0\u4f9b\u7684\u516c\u5f00\u7f51\u5740",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "title": "Urls",
              "type": "array"
            }
          },
          "required": [
            "urls"
          ],
          "title": "WebReadArguments",
          "type": "object"
        }
      }
    }
