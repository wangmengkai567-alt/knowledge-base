# 复制为仓库根目录 .env（Compose 读取）和 ai-service/.env（本机后端读取）
# 当前选择：千问对话、嵌入和重排。密钥仅写在本地 .env，不提交 Git。

# Docker Compose 起 Postgres 时必填
POSTGRES_PASSWORD=changeme
# 本机 Python 连 Docker 里的 Postgres 时取消注释，密码与上一行相同
# AI_DATABASE__URL=postgresql+asyncpg://ai_kb:changeme@localhost:5432/ai_kb

# 浏览器直连 :8084 时需要；走 Vite /api 代理可不配
AI_SERVER__CORS_ORIGINS=["http://localhost:5173"]
AI_SERVER__CORS_CREDENTIALS=true

# 对话和嵌入使用项目已有的兼容协议，因此提供商名称填 openai；模型仍为千问。
AI_SERVER__WORKERS=1
AI_LLM__PROVIDER=openai
AI_LLM__API_KEY=
AI_LLM__BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_LLM__CHAT_MODEL=qwen3.8-flash
AI_EMBEDDING__PROVIDER=openai
AI_EMBEDDING__API_KEY=
AI_EMBEDDING__BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_EMBEDDING__MODEL=qwen3.7-text-embedding-flash
AI_EMBEDDING__DIMENSION=1024
# 重排使用千问原生接口。
AI_RERANKER__PROVIDER=qwen
AI_RERANKER__API_KEY=
AI_RERANKER__BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
AI_RERANKER__MODEL=qwen3.7-text-rerank

# Tavily 仅用于搜索；Compose 与本机应用均读取搜索密钥。
# 未配置时网页搜索返回 TOOL_NOT_CONFIGURED；公开 HTML 正文读取不需要该密钥。
TAVILY_API_KEY=
# 单次工具默认上限 30 秒（可配置至 60 秒）；实际等待还受整次问答 120 秒截止时间约束。
AI_TOOLS__TIMEOUT=30

# 正文读取上限：总时限 20 秒，窗口最多 2000 token；不切断代码块。
AI_WEB_READER__TIMEOUT=20
AI_TOKEN_BUDGET__PAGE_TOKENS=2000
AI_TOKEN_BUDGET__SUMMARY_TOKENS=512
AI_TOKEN_BUDGET__PREVIEW_TOKENS=64
AI_TOKEN_BUDGET__TOOL_RESULT_MAX_TOKENS=3000
AI_TOKEN_BUDGET__TOOL_RESULT_MAX_BYTES=12000
AI_TOKEN_BUDGET__INPUT_LIMIT=16000
AI_TOKEN_BUDGET__OUTPUT_LIMIT=2048
AI_TOKEN_BUDGET__TOTAL_TOKENS=64000
AI_TOKEN_BUDGET__SAFETY_RATIO=0.1
AI_TOKEN_BUDGET__FIXED_RESERVE_TOKENS=256
