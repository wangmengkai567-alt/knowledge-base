# 复制为仓库根目录 .env（Compose 读取）和 ai-service/.env（python -m cmd.main 读取）

# Docker Compose 起 Postgres 时必填
POSTGRES_PASSWORD=changeme
# 本机 Python 连 Docker 里的 Postgres 时取消注释，密码与上一行相同
# AI_DATABASE__URL=postgresql+asyncpg://ai_kb:changeme@localhost:5432/ai_kb

# 浏览器直连 :8084 时需要；走 Vite /api 代理可不配
AI_SERVER__CORS_ORIGINS=["http://localhost:5173"]
AI_SERVER__CORS_CREDENTIALS=true

# 智谱。对话 / 向量 / 重排共用一把 Key；后两个留空则复用 AI_LLM__API_KEY。
# 换模型只改对应的 MODEL 变量，不必改代码。
AI_LLM__PROVIDER=zhipu
AI_LLM__API_KEY=
AI_LLM__BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_LLM__CHAT_MODEL=glm-4-flash
AI_EMBEDDING__PROVIDER=zhipu
AI_EMBEDDING__BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_EMBEDDING__MODEL=embedding-3
AI_EMBEDDING__DIMENSION=1024
AI_RERANKER__PROVIDER=zhipu
AI_RERANKER__API_KEY=
AI_RERANKER__BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_RERANKER__MODEL=rerank
